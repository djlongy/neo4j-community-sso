# Replace these site values before applying. Never put secrets in this ConfigMap.
BOLT_ADDRESS=neo4j.example.internal:443
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=http://127.0.0.1:8080
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_CLIENT_ID=neo4j-community-sso
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_OIDC_ISSUER_URL=https://idp.example.internal/realms/example
OAUTH2_PROXY_REDIRECT_URL=https://neo4j.example.internal/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile
OAUTH2_PROXY_EMAIL_DOMAINS=example.internal
OAUTH2_PROXY_ALLOWED_GROUPS=neo4j-users
OAUTH2_PROXY_COOKIE_NAME=_neo4j_sso
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_EXPIRE=1h
OAUTH2_PROXY_COOKIE_REFRESH=5m
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_PROXY_WEBSOCKETS=true
OAUTH2_PROXY_REVERSE_PROXY=true
# Replace with the source CIDR(s) of your ingress controller pods/nodes.
OAUTH2_PROXY_TRUSTED_PROXY_IPS=192.0.2.0/24
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_REQUEST_LOGGING=false
