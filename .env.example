# Existing OIDC provider: register PUBLIC_URL/oauth2/callback as an exact redirect URI.
PUBLIC_URL=https://neo4j.example.internal
BOLT_ADDRESS=neo4j.example.internal:443
HTTP_PORT=7476
OIDC_ISSUER_URL=https://idp.example.internal/realms/example
OIDC_CLIENT_ID=neo4j-community-sso
# Set your confidential client secret; public PKCE clients use unused-public-client.
OIDC_CLIENT_SECRET=
ALLOWED_GROUPS=neo4j-users
EMAIL_DOMAINS=example.internal
COOKIE_SECURE=true
REVERSE_PROXY=true
# Replace with the source CIDR of your TLS reverse proxy as seen by oauth2-proxy.
TRUSTED_PROXY_IPS=192.0.2.0/24
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COOKIE_SECRET=
